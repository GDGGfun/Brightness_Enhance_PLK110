<?xml version="1.0" encoding="UTF-8" standalone='yes' ?>
<root>
    <oplsadfrCfg>
        <version>20250925</version>
        <mode name="adfr2minfps_config">
           <!--自适应降帧功能使能-->
            <enable>1</enable>
            <!--debug log开关-->
            <debug_enable>0</debug_enable>
            <!--sensor识别开关-->
            <sensor_enable>0</sensor_enable>
            <!--panelnit识别开关-->
            <panelnit_enable>1</panelnit_enable>
            <!--灰阶识别开关-->
            <gray_enable>1</gray_enable>
            <!--埋点开关-->
            <tracking_switch>1</tracking_switch>
            <!--统计灰阶阈值开关-->
            <gray_cal>0</gray_cal>
            <!--直方图采样频率（1-15直方图每帧都检测，>15直方图按照每隔sampleInterval帧检测一次）-->
            <sampleInterval>0</sampleInterval>
            <!--sensorlux的阈值，决定是否是暗环境-->
            <!--如果当前是亮环境，lux<sensor_inlux会被判为暗环境-->
            <sensor_inlux>15</sensor_inlux>
            <!--如果当前是暗环境，lux>sensor_outlux会被判为亮环境-->
            <sensor_outlux>40</sensor_outlux>
            <!--手动亮度下sensorlux的开关间隔，单位秒-->
            <sensor_gaptime>10</sensor_gaptime>
            <!--全景AOD参数开关-->
            <fullscreen_aod>15</fullscreen_aod>
            <!--保留模式参数开关-->
            <reserve_mode>0</reserve_mode>
            <!--panelnit_level从大到小排序 >68nit关闭直方图，<27nit为直方图检测(20,0]-->
            <panelnit_level>50 30 20 10</panelnit_level>
            <!--不同亮度对应的灰阶分界线-->
            <!--不同亮度对应的Y分组-->
            <Y_l_level>0 0 0 0</Y_l_level>
            <Y_h_level>5 5 9 12</Y_h_level>
            <!--不同亮度对应的灰阶SUM百分比阈值-->
            <sum_level>70 70 50 20</sum_level>
            <!--不同亮度对应的灰阶MAX百分比阈值-->
            <max_level>70 70 25 10</max_level>
            <!--最前面两个值为>=70nit时不同sensorlux的minfps 后面的都是不同亮度不同灰阶对应的minfps-->
            <!--举例：<minfps120_level>10 1 10 1 30 1 120 10</minfps120_level>-->
            <!--10 1 (>70nit 暗环境为10hz,亮环境为1HZ)-->
            <!--10 1 (50-70nit 低灰阶为10hz,高灰阶为1HZ)-->
            <!--30 1 (20-50nit 低灰阶为30hz,高灰阶为1HZ)-->
            <!--120 10 (<20nit 低灰阶为120hz,高灰阶为1HZ)-->
            <minfps120_level>1 1 30 1 120 1 120 10 120 10</minfps120_level>
            <minfps90_level>1 1 30 1 90 1 90 10 90 10</minfps90_level>
            <minfps60_level>1 1 30 1 60 1 60 10 60 10</minfps60_level>
            <!--全景全天候aod panelnit_level从大到小排序 >50nit关闭直方图，<50nit为直方图检测(50,0]-->
            <aod_panelnit_level>50 30 20</aod_panelnit_level>
            <!--不同亮度对应的灰阶分界线-->
            <aod_Y_l_level>0 0 0</aod_Y_l_level>
            <aod_Y_h_level>4 4 6</aod_Y_h_level>
            <!--不同亮度对应的灰阶SUM百分比阈值-->
            <aod_sum_level>70 70 70</aod_sum_level>
            <!--不同亮度对应的灰阶MAX百分比阈值-->
            <aod_max_level>70 70 70</aod_max_level>
            <!--不同亮度不同灰阶对应的帧率档位-->
            <aod_minfps120_level>1 1 30 1 120 1 120 10</aod_minfps120_level>
            <aod_minfps90_level>1 1 30 1 90 1 90 10</aod_minfps90_level>
            <aod_minfps60_level>1 1 30 1 60 1 60 10</aod_minfps60_level>
        </mode>
