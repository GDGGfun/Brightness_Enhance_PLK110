    <panel_id>
        <id1 id="67">
            <id2 id="00">evb</id2>
            <id2 id="01">t0</id2>
            <id2 id="02">evt</id2>
            <id2 id="03">dvt</id2>
            <id2 id="04">pvt</id2>
            <!-- default must be last one -->
            <id2 id="*">default</id2>
        </id1>
        <!-- other must be last one, it is for the wrong panel -->
        <id1 id="*">
            <id2 id="*">other</id2>
        </id1>
    </panel_id>

    <panel_stage stages="dvt,pvt,default">

        <!-- pwm: 3+18, bind_point max count:10, must sorted, the last one must be 4096 -->
        <pwm_bind_points>
            <!-- 10nit -->
            <bind_point id="1" bin_id="1">414</bind_point>
        </pwm_bind_points>

        <!-- dc1: 1+18, bind_point max count:10, must sorted, the last one must be 4096 -->
        <dc1_bind_points>
            <!-- 1nit -->
            <bind_point id="0" bin_id="0">100</bind_point>
            <!-- 10nit -->
            <bind_point id="1" bin_id="1">414</bind_point>
            <!-- 200nit -->
            <bind_point id="2" bin_id="3">1869</bind_point>
            <!-- sentinel value -->
            <bind_point id="3" bin_id="4">4096</bind_point>
        </dc1_bind_points>

        <!-- dc2: 1+1, bind_point max count:10, must sorted, the last one must be 4096 -->
